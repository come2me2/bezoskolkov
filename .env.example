# Доставка заявок: SMTP и/или Telegram (на ONREZA Gmail SMTP часто недоступен)

# --- Telegram (рекомендуется для ONREZA) ---
# 1) Создайте бота у @BotFather → получите TELEGRAM_BOT_TOKEN
# 2) Напишите боту /start, узнайте chat_id (@userinfobot или getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMTP (локально с Gmail работает; с серверов в РФ часто таймаут) ---
# SMTP_USER должен быть тем ящиком, для которого создан пароль приложения
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=belieokna2009@gmail.com
SMTP_PASS=
SMTP_FROM="БезОсколков <belieokna2009@gmail.com>"

# Альтернатива в РФ: Яндекс Почта
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=you@yandex.ru
# SMTP_PASS=пароль_приложения

# Куда слать заявки по почте (через запятую)
LEAD_TO=belieokna2009@gmail.com,sir.kalinin@gmail.com
