# Доставка заявок: Яндекс SMTP (рекомендуется для ONREZA)
# Получатели писем — в LEAD_TO (можно Gmail). Отправитель SMTP_USER — только ящик Яндекса.

# 1) Почта на https://mail.yandex.ru (или домен на Яндекс 360)
# 2) Настройки → Почтовые программы → включить «С сервера imap.yandex.ru по протоколу IMAP»
# 3) Пароли приложений: https://id.yandex.ru/security/app-passwords
#    Создайте пароль для «Почта» → вставьте в SMTP_PASS (без пробелов)

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=come2me5@yandex.ru
SMTP_PASS=
SMTP_FROM="БезОсколков <come2me5@yandex.ru>"

# Куда слать заявки (через запятую) — сюда ваши рабочие ящики
LEAD_TO=belieokna2009@gmail.com,sir.kalinin@gmail.com

